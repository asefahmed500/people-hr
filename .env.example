# PeopleHR environment variables
# Copy to .env and fill in the values you need. Every optional integration
# degrades gracefully when left empty.

# Server port used by `npm run dev` (Next may bind another port if you pass --port).
PORT=3001

# PostgreSQL (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peoplehr?schema=public"

# Auth.js v5 (required — generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3001"

# Google OAuth2 (optional). Sign-in stays disabled unless BOTH are real and
# NEXT_PUBLIC_GOOGLE_ENABLED=true. Redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED=false

# Password reset email (optional but REQUIRED in production)
# Without RESEND_API_KEY, password reset returns 503 in production and shows
# the link inline only in development. No SMTP transport is used.
RESEND_API_KEY=""
EMAIL_FROM="PeopleHR <no-reply@your-domain.com>"
# Legacy placeholders — retained for compatibility, not currently used for delivery.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# AI assistant, agent, embeddings and RAG search (optional)
# Use any OpenAI-compatible endpoint. For Z.AI set ZAI_API_KEY alone to default
# to https://api.z.ai/api/paas/v4 and glm-5.3.
LLM_API_KEY=""
ZAI_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_EMBEDDING_DIMENSIONS=1536

# Billing (optional). Without STRIPE_SECRET_KEY, billing reports "not configured".
STRIPE_SECRET_KEY=""
STRIPE_PORTAL_URL=""

# Networking (optional). Trust x-forwarded-for from a reverse proxy only when
# you are certain the proxy overwrites it; otherwise rate limits key on x-real-ip.
TRUST_PROXY=false
